{
  "name": "investor-view",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:frontend": "cd frontend && npm start",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && flask run",
    "start:dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:prod": "npm run build:frontend && cd backend && gunicorn app:app --bind 0.0.0.0:8000"
  },
  "devDependencies": {
    "concurrently": "^7.0.0"
  }
}